{
  "tasks": {
    "dev": "deno run -P=build esbuild.config.ts",
    "build": "deno run -P=build esbuild.config.ts production",
    "version-bump": "deno run -P=version-bump version-bump.ts && git add manifest.json versions.json"
  },
  "permissions": {
    "build": {
      "read": true,
      "write": true,
      "net": [
        "esm.sh",
        "jsr.io",
        "registry.npmjs.org",
        "deno.land"
      ],
      "run": true,
      "env": true
    },
    "version-bump": {
      "read": [
        "./manifest.json",
        "./versions.json"
      ],
      "write": [
        "./versions.json"
      ]
    }
  },
  "compilerOptions": {
    "noImplicitAny": true,
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "imports": {
    "@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2.1",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "builtin-modules": "npm:builtin-modules@5.0.0",
    "esbuild": "npm:esbuild@^0.27.7",
    "obsidian": "npm:obsidian@^1.12.3",
    "obsidian-daily-notes-interface": "https://esm.sh/obsidian-daily-notes-interface@0.9.4?external=obsidian"
  }
}
